{
	on_demand_tls {
		route_probe {
			method GET
			timeout 5s
			random_host_probe false
		}
	}
}

*.example.com {
	tls {
		on_demand
	}
	reverse_proxy http://backend:8080
}
----------
{
	"apps": {
		"http": {
			"servers": {
				"srv0": {
					"listen": [
						":443"
					],
					"routes": [
						{
							"match": [
								{
									"host": [
										"*.example.com"
									]
								}
							],
							"handle": [
								{
									"handler": "subroute",
									"routes": [
										{
											"handle": [
												{
													"handler": "reverse_proxy",
													"upstreams": [
														{
															"dial": "backend:8080"
														}
													]
												}
											]
										}
									]
								}
							],
							"terminal": true
						}
					]
				}
			}
		},
		"tls": {
			"automation": {
				"policies": [
					{
						"subjects": [
							"*.example.com"
						],
						"on_demand": true
					}
				],
				"on_demand": {
					"permission": {
						"method": "GET",
						"module": "route_probe",
						"random_host_probe": false,
						"timeout": 5000000000
					}
				}
			}
		}
	}
}
